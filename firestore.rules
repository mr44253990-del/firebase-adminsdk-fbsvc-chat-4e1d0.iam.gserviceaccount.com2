rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owner(uid)
        && (request.resource.data.role == null || request.resource.data.role == 'user' || request.auth.token.email == 'mr4425390@gmail.com')
        && (request.resource.data.isPremium == null || request.resource.data.isPremium == false ||
          (request.resource.data.isPremium == true && request.resource.data.premiumPlan == 'trial'
            && request.resource.data.premiumTrialClaimed == true && request.resource.data.premiumSource == 'signup_trial'
            && request.resource.data.premiumUntil <= request.time.toMillis() + 1211400000));
      allow delete: if owner(uid);
      allow update: if (owner(uid)
        && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'premiumPlan', 'premiumUntil', 'premiumApprovedAt', 'premiumTrialClaimed', 'premiumSource']))
        || request.auth.token.email == 'mr4425390@gmail.com' || (
        signedIn()
        && exists(/databases/$(database)/documents/friend_requests/$(uid + "_" + request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && request.auth.uid in request.resource.data.friends
      ) || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        && (request.auth.uid in request.resource.data.followers || request.auth.uid in resource.data.followers)
      );

      match /notifications/{notificationId} {
        allow read, delete: if owner(uid);
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.ownerId == uid;
      }
    }

    match /fcm_tokens/{uid} {
      allow create, update, delete: if owner(uid);
      allow read: if owner(uid); // Worker service account bypasses client rules.
    }

    // Clients may acknowledge their own push/probe only. The Worker service account
    // owns presence leases and admin reads; client writes cannot extend onlineUntil.
    match /presence/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['lastPushReceivedAt', 'lastProbeReceivedAt', 'lastProbeId'])
        && request.resource.data.lastPushReceivedAt == request.time
        && (!('lastProbeReceivedAt' in request.resource.data)
          || request.resource.data.lastProbeReceivedAt == request.time)
        && (!('lastProbeId' in request.resource.data)
          || (request.resource.data.lastProbeId is string && request.resource.data.lastProbeId.size() <= 128));
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPushReceivedAt', 'lastProbeReceivedAt', 'lastProbeId'])
        && request.resource.data.lastPushReceivedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastProbeReceivedAt'])
          || request.resource.data.lastProbeReceivedAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastProbeId'])
          || (request.resource.data.lastProbeId is string && request.resource.data.lastProbeId.size() <= 128));
      allow delete: if owner(uid);
    }

    match /friend_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read, delete: if signedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow update: if false;
    }

    match /message_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read, delete: if signedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow update: if false;
    }

    // Storage routing contains only public URL/provider/bucket metadata so new users can
    // select a profile photo before account creation. It must never contain a secret key.
    match /app_config/storage {
      allow read: if true;
      allow write: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
    }

    // Admin-only secrets (AI provider API keys). Never readable by regular users; the
    // Worker / Edge Function read it with the service account.
    // Admin audit trail: admin-only, append-only.
    match /admin_audit/{entryId} {
      allow read, create: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
      allow update, delete: if false;
    }

    match /admin_secrets/{documentId} {
      allow read, write: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
    }

    // Live location shares: the sender writes, both chat members read.
    match /live_locations/{shareId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /app_config/{documentId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
    }

    // Admin-managed chat background gallery. Images live in storage; this collection only
    // holds public URLs and labels.
    match /chatBackgrounds/{backgroundId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com'
        && request.resource.data.url is string && request.resource.data.url.matches('https://.*')
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
    }

    match /feature_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid;
      allow read: if signedIn() && (resource.data.requesterId == request.auth.uid || request.auth.token.email == 'mr4425390@gmail.com');
      allow update, delete: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
    }

    match /premium_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() >= 6;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'mr4425390@gmail.com');
      allow update, delete: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
    }

    // Admin polls: everyone reads, only the admin creates/ends them. Voters may only bump the
    // aggregate counters, and each vote document is readable by its voter and the admin.
    match /polls/{pollId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
      allow update: if signedIn() && (
        request.auth.token.email == 'mr4425390@gmail.com'
        || (resource.data.active == true
            && resource.data.endsAt > request.time.toMillis()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'totalVotes']))
      );
      match /votes/{voterId} {
        allow read: if signedIn() && (request.auth.uid == voterId || request.auth.token.email == 'mr4425390@gmail.com');
        allow create, update: if owner(voterId)
          && request.resource.data.optionIndex is int
          && get(/databases/$(database)/documents/polls/$(pollId)).data.active == true
          && get(/databases/$(database)/documents/polls/$(pollId)).data.endsAt > request.time.toMillis();
        allow delete: if signedIn() && request.auth.token.email == 'mr4425390@gmail.com';
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.senderId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'reactions', 'shares'])
      );
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.senderId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'viewers', 'reactions', 'comments'])
      );
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn()
          && resource.data.senderId == request.auth.uid;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
