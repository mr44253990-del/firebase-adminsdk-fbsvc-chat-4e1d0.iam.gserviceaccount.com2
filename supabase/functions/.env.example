# Copy to supabase/functions/.env for local testing (never commit the real file).
# Paste the whole Firebase service-account JSON on ONE line:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# At least 24 random characters. Generate: openssl rand -hex 32
PRESENCE_CRON_SECRET=replace-with-openssl-rand-hex-32
# Optional, defaults to the Convo admin account
ADMIN_EMAIL=
